#!/usr/bin/env bash
# Block commits that contain secrets. Belt-and-suspenders behind .gitignore —
# catches the case where someone runs `git add -f .env` or pastes a key into
# tracked source. Fast (only inspects staged content).
#
# Activate per-clone: `git config core.hooksPath .githooks`

set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
  exit 0
fi

# 1. Reject .env / .env.local / .env.<env> files (regardless of contents).
#    Allow templates: .env.example, .env.sample, .env.template — these are
#    intentional docs that never carry real values.
env_files=$(echo "$staged" | grep -E '(^|/)\.env($|\.[A-Za-z0-9_-]+$)' | grep -vE '\.(example|sample|template)$' || true)
if [ -n "$env_files" ]; then
  echo "❌ Refusing to commit .env file(s):"
  echo "$env_files" | sed 's/^/    /'
  echo "   Move secrets to .env (which is git-ignored) or unstage with:"
  echo "       git restore --staged $env_files"
  exit 1
fi

# 2. Scan staged diff for known secret signatures.
# Patterns are intentionally narrow — false positives block commits.
patterns=(
  'AIza[0-9A-Za-z_-]{35}'                 # Google API key
  'sk-[A-Za-z0-9]{20,}'                   # OpenAI / Anthropic-style secret key
  '-----BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY-----'
  'xox[baprs]-[0-9A-Za-z-]{10,}'          # Slack token
  'ghp_[A-Za-z0-9]{36}'                   # GitHub personal access token
  'gho_[A-Za-z0-9]{36}'                   # GitHub OAuth token
)

# Inspect diff content (not file contents); avoids noise from untouched lines.
diff=$(git diff --cached -U0)
for pattern in "${patterns[@]}"; do
  # Use -e so patterns beginning with '-' aren't parsed as flags (BSD grep).
  if echo "$diff" | grep -E -e "$pattern" >/dev/null; then
    echo "❌ Secret pattern detected in staged diff: /$pattern/"
    echo "   Inspect with: git diff --cached"
    exit 1
  fi
done

exit 0
