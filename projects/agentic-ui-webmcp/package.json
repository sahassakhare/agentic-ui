{
  "name": "@infra-tools/agentic-ui-webmcp",
  "version": "1.2.2",
  "description": "WebMCP adapter for @infra-tools/agentic-ui — exposes the host app's ToolRegistry to an in-browser agent via the navigator.modelContext proposal. Tools register/unregister reactively; every inbound call is scope- and approval-gated. Optional plugin; stays outside the core lib per ADR-010 D4.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sahassakhare/agentic-ui#readme",
  "bugs": {
    "url": "https://github.com/sahassakhare/agentic-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahassakhare/agentic-ui",
    "directory": "projects/agentic-ui-webmcp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.0",
    "@infra-tools/agentic-ui": "^1.2.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "@angular/core": "^21.0.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5",
    "zod": "^3.23.8"
  }
}
