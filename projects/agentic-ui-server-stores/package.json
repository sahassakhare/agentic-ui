{
  "name": "@infra-tools/agentic-ui-server-stores",
  "version": "1.2.1",
  "description": "Redis and Postgres adapters for @infra-tools/agentic-ui-server's ThreadStateStore interface — multi-pod-safe thread state for production deployments.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sahassakhare/agentic-ui#readme",
  "bugs": {
    "url": "https://github.com/sahassakhare/agentic-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahassakhare/agentic-ui",
    "directory": "projects/agentic-ui-server-stores"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./redis": {
      "import": "./dist/redis.js",
      "types": "./dist/redis.d.ts"
    },
    "./postgres": {
      "import": "./dist/postgres.js",
      "types": "./dist/postgres.d.ts"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@infra-tools/agentic-ui-server": ">=0.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@infra-tools/agentic-ui-server": "file:../agentic-ui-server",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.0",
    "pg": "^8.11.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  }
}
