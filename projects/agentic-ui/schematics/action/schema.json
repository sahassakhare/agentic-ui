{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MaverickAgenticUiAction",
  "title": "Generate an agentic action (NgRx-style command)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Action type (camelCase, e.g., navigateToBooking)?"
    },
    "project": { "type": "string", "$default": { "$source": "projectName" } },
    "path": { "type": "string", "default": "app/agentic/actions" },
    "description": { "type": "string", "default": "Action description." }
  },
  "required": ["name"]
}
