{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MaverickAgenticUiWidget",
  "title": "Generate a generative-UI widget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Widget name (PascalCase recommended).",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What name should the widget have?"
    },
    "project": { "type": "string", "$default": { "$source": "projectName" } },
    "path": { "type": "string", "default": "app/agentic/widgets" },
    "prefix": { "type": "string", "default": "app", "description": "Selector prefix." }
  },
  "required": ["name"]
}
