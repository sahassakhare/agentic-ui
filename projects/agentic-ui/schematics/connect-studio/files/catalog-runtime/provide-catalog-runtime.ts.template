import { EnvironmentProviders, makeEnvironmentProviders, provideAppInitializer, inject } from '@angular/core';
import { CATALOG_CONFIG, type CatalogRuntimeConfig, type ResolvedCatalogConfig } from './catalog.config';
import {
  CatalogExperienceSource, CatalogDataSource, CatalogToolSource,
  CatalogFormSource, CatalogWorkflowSource,
} from './sources';

/**
 * Connect this app to an Experience Studio catalog backend.
 *
 * Add to `app.config.ts` **alongside `provideAgenticUi()` / `provideAgenticUiPlatform()`**
 * (the lib platform must be present so the target registries — `FormRegistry`,
 * `ToolRegistry`, … — exist):
 *
 * ```ts
 * providers: [
 *   provideAgenticUi(),
 *   provideCatalogRuntime({ baseUrl: 'http://localhost:8081', tenant: 'acme' }),
 * ]
 * ```
 *
 * At boot it hydrates the tenant's governed capabilities into the lib registries
 * and keeps them live over SSE. Order matters: data sources register before
 * tools (a tool resolves its data source at call time, but hydrating sources
 * first keeps the first agent turn consistent).
 *
 * For OIDC, also provide a `CATALOG_AUTH` that returns the current bearer token.
 */
export function provideCatalogRuntime(config: CatalogRuntimeConfig): EnvironmentProviders {
  const cfg: ResolvedCatalogConfig = {
    authMode: 'disabled',
    dataSourceSecrets: {},
    ...config,
  };
  return makeEnvironmentProviders([
    { provide: CATALOG_CONFIG, useValue: cfg },

    provideAppInitializer(async () => {
      const s = inject(CatalogExperienceSource);
      await s.hydrate();
      s.startLiveSync();
    }),
    provideAppInitializer(async () => {
      const s = inject(CatalogDataSource);
      await s.hydrate();       // endpoints first…
      s.startLiveSync();
    }),
    provideAppInitializer(async () => {
      const s = inject(CatalogToolSource);
      await s.hydrate();       // …then the tools that bind them
      s.startLiveSync();
    }),
    provideAppInitializer(async () => {
      const s = inject(CatalogFormSource);
      await s.hydrate();
      s.startLiveSync();
    }),
    provideAppInitializer(async () => {
      const s = inject(CatalogWorkflowSource);
      await s.hydrate();
      s.startLiveSync();
    }),
  ]);
}
