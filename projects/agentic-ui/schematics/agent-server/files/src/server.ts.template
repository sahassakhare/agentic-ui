/**
 * AG-UI agent server scaffold for "<%= dasherize(name) %>".
 *
 * Generated by `ng g @maverick/agentic-ui:agent-server`. The default setup
 * registers a single `EchoAgent` (no LLM) so you can verify the SSE pipeline
 * end-to-end before plugging in a real model. Add LLM-backed agents (e.g.,
 * a `GeminiAgent`) by constructing them and putting them in the resolver
 * map below.
 *
 * Architecture:
 *  - `agUiRouteHandler` wraps each `agent.run()` async iterable as a
 *    Server-Sent Events stream the browser library can consume.
 *  - The `AgentResolver` lets one process host many agents under
 *    `/agents/<id>/run`, so you can register specialists alongside an
 *    orchestrator without spinning up multiple servers.
 *
 * @see https://github.com/sahassakhare/agentic-ui/blob/main/docs/cookbook/integrate-into-existing-angular-app.md#phase-1--wire-the-chat-shell
 */
import { serve } from '@hono/node-server';
import { Hono } from 'hono';
import { cors } from 'hono/cors';
import { agUiRouteHandler, EchoAgent, type AgentResolver } from '@maverick/agentic-ui-server';

/** Listening port. Override with the `PORT` env var without rebuilding. */
const PORT = Number(process.env['PORT'] ?? <%= port %>);

/**
 * Default agent registered at `/agents/echo/run`. Streams the user's last
 * message back word-by-word — useful for testing the SSE pipeline before
 * wiring an LLM. Replace or extend by adding entries to the resolver below.
 */
const echoAgent = new EchoAgent('echo');

/**
 * Resolves an agent id (taken from the URL path) to a `ServerAgent`
 * implementation. Add more agents by extending the lookup:
 *
 * ```ts
 * const agents = new Map<string, ServerAgent>();
 * agents.set('echo', echoAgent);
 * agents.set('gemini', new GeminiAgent('gemini', { apiKey, ... }));
 * const resolver: AgentResolver = { resolve: (id) => agents.get(id) };
 * ```
 *
 * For multi-agent orchestration, see the `OrchestratorAgent` pattern in the
 * cookbook (`docs/cookbook/multi-agent-orchestration.md`).
 */
const resolver: AgentResolver = {
  resolve(id) { return id === 'echo' ? echoAgent : undefined; },
};

/**
 * Single AG-UI route handler shared across every agent id. Encodes each
 * yielded `BaseEvent` (text deltas, tool calls, lifecycle events) as one
 * SSE frame using `@ag-ui/encoder`.
 */
const handler = agUiRouteHandler({ resolver });
const app = new Hono();

// CORS: permissive in this scaffold — tighten to an explicit allowlist for
// production (e.g., process.env.CORS_ORIGINS.split(',')).
app.use('*', cors({ origin: (o) => o ?? '*', allowMethods: ['POST', 'OPTIONS'], allowHeaders: ['Content-Type', 'Accept'] }));

/** Liveness probe — useful for container orchestrators. */
app.get('/health', (c) => c.json({ ok: true, agents: ['echo'] }));

/** AG-UI run endpoint. The browser library posts here over SSE. */
app.post('/agents/:id/run', async (c) => handler(c.req.raw));

serve({ fetch: app.fetch, port: PORT }, (info) => {
  console.log(`[<%= dasherize(name) %>] AG-UI route at http://localhost:${info.port}/agents/echo/run`);
});
