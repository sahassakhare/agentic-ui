{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MaverickAgenticUiBackend",
  "title": "Generate a custom AgenticBackend adapter",
  "type": "object",
  "properties": {
    "name": { "type": "string", "$default": { "$source": "argv", "index": 0 }, "x-prompt": "Backend name?" },
    "project": { "type": "string", "$default": { "$source": "projectName" } },
    "path": { "type": "string", "default": "app/agentic/backends" }
  },
  "required": ["name"]
}
