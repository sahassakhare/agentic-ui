{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MaverickAgenticUiForm",
  "title": "Generate a schema-driven form",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Form name (e.g., bookFlightForm)?"
    },
    "project": { "type": "string", "$default": { "$source": "projectName" } },
    "path": { "type": "string", "default": "app/agentic/forms" },
    "description": { "type": "string", "default": "Form description." }
  },
  "required": ["name"]
}
