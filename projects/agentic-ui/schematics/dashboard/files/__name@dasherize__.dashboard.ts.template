import type { DashboardDef } from '@infra-tools/agentic-ui';

/**
 * `<%= camelize(name) %>Dashboard` — `DashboardRegistry` registration.
 *
 * Per [ADR-044](../adr/0044-dashboard-registry.md), every tile is one
 * of three: a tool invocation (re-fired on refresh, chain-hashed), a
 * data-source query (re-queried on refresh, no audit entry), or
 * static props. Adding a new tile kind = registering a new widget in
 * `ComponentRegistry`. No bespoke tile component zoo.
 *
 * Persona scope filters tiles automatically — unauthorised tiles
 * render as "no-access" stubs, not 403s, not silent omissions.
 *
 * Register at boot:
 * ```ts
 * inject(DashboardRegistry).register(<%= camelize(name) %>Dashboard);
 * ```
 *
 * Render on a route:
 * ```html
 * <mvk-dashboard-canvas [dashboard]="dashboards.get('<%= camelize(name) %>')" />
 * ```
 */
export const <%= camelize(name) %>Dashboard: DashboardDef = {
  name: '<%= camelize(name) %>',
  title: '<%= title %>',
  description: '<%= description %>',
  layout: '<%= layout %>',
  tiles: [
    // Example tool tile — re-invokes the tool on refresh.
    // {
