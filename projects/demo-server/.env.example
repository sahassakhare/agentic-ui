# Copy this file to `.env` and fill in your key. The .env file is git-ignored.
#
# Get an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override (default: gemini-2.0-flash-exp).
# GEMINI_MODEL=gemini-2.0-flash-exp

# Optional port override (default 4111).
# PORT=4111
