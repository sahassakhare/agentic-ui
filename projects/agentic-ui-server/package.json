{
  "name": "@maverick/agentic-ui-server",
  "version": "0.1.0",
  "description": "Server-side helpers for @maverick/agentic-ui — generic Agent interface, AG-UI SSE route handler, in-memory thread store.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist/**"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.52",
    "@ag-ui/encoder": "0.0.52"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0"
  }
}
