{
  "name": "@infra-tools/agentic-ui-teams-bot",
  "version": "1.2.2",
  "description": "Microsoft Teams Bot Framework adapter for the @infra-tools/agentic-ui platform. Translates AgenticBackend events into Adaptive Cards posted into Teams chat conversations. Verifies inbound Bot Framework JWTs and signs outbound replies with the bot's AAD credentials. Adopters bring their own LLM behind a TeamsBotHandler.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sahassakhare/agentic-ui#readme",
  "bugs": {
    "url": "https://github.com/sahassakhare/agentic-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahassakhare/agentic-ui",
    "directory": "projects/agentic-ui-teams-bot"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  }
}
