{
  "name": "@infra-tools/agentic-ui-m365-agents",
  "version": "1.2.3",
  "description": "Microsoft 365 Agents SDK adapter for the @infra-tools/agentic-ui platform. Successor to the Bot Framework adapter — same Activity wire, broader channel set (Teams + M365 Copilot + Direct Line + Webchat) and AAD-channel issuer support. Adopters bring their own LLM behind an M365AgentHandler.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sahassakhare/agentic-ui#readme",
  "bugs": {
    "url": "https://github.com/sahassakhare/agentic-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sahassakhare/agentic-ui",
    "directory": "projects/agentic-ui-m365-agents"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.5"
  }
