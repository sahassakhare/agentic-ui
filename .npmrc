# Workspace-wide: tolerate peer-dep mismatches the same way our package
# locks were generated. Without this, `npm ci` fails because transitive
# peers (e.g. @module-federation/enhanced — a required peer of
# @angular-architects/module-federation-runtime) aren't recorded in the
# packages section of package-lock.json. Locks were originally produced
# with this flag set in the maintainer's user-level npmrc, which is why
# CI (without it) saw the lock as out-of-sync. Setting it at the repo
# level makes installs deterministic across local and CI.
legacy-peer-deps=true
