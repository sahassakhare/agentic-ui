{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "packageManager": "npm",
    "schematicCollections": [
      "@schematics/angular"
    ],
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "changeDetection": "OnPush",
      "skipTests": false,
      "standalone": true
    },
    "@schematics/angular:directive": {
      "standalone": true
    },
    "@schematics/angular:pipe": {
      "standalone": true
    },
    "@schematics/angular:application": {
      "ssr": false
    }
  },
  "projects": {
    "agentic-ui": {
      "projectType": "library",
      "root": "projects/agentic-ui",
      "sourceRoot": "projects/agentic-ui/src",
      "prefix": "mvk",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/agentic-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/agentic-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/agentic-ui/tsconfig.spec.json",
            "include": [
              "**/*.spec.ts"
            ]
          }
        }
      }
    },
    "demo-monolith": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "examples/demo-monolith",
      "sourceRoot": "examples/demo-monolith/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "examples/demo-monolith/src/main.ts",
            "tsConfig": "examples/demo-monolith/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "examples/demo-monolith/public"
              }
            ],
            "styles": [
              "examples/demo-monolith/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "examples/demo-monolith/src/environments/environment.ts",
                  "with": "examples/demo-monolith/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4202
          },
          "configurations": {
            "production": {
              "buildTarget": "demo-monolith:build:production"
            },
            "development": {
              "buildTarget": "demo-monolith:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
