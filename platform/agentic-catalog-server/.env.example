# @maverick/agentic-catalog-server — environment variables.
#
# 12-factor configuration; every value below is required at startup
# unless marked OPTIONAL. Copy to .env (gitignored) for local dev.

# ── Bind ───────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ── Database (Postgres 14+) ────────────────────────────────────────
# Connection string format documented at
# https://node-postgres.com/features/connecting#connection-uri.
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog

# OPTIONAL — connection pool tuning. Defaults shown.
DATABASE_POOL_MAX=10
DATABASE_IDLE_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000

# ── OIDC (federated identity) ──────────────────────────────────────
# The issuer URL. The server resolves the JWKS at
# `${OIDC_ISSUER}/.well-known/jwks.json` unless OIDC_JWKS_URI overrides.
# Examples:
#   Auth0:   https://your-tenant.auth0.com/
#   Keycloak: https://idp.example.com/realms/agentic
#   Okta:    https://your-org.okta.com/oauth2/default
#   Azure AD: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=https://your-idp.example.com/

# The expected `aud` claim. Mint tokens with this audience or they
# get rejected at verification.
OIDC_AUDIENCE=agentic-catalog

# OPTIONAL — non-default JWKS URI.
# OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json

# OPTIONAL — custom claim names.
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles

# ── Logging ────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# json | pretty (use `pretty` only for local dev)
LOG_FORMAT=json

# ── Operations ─────────────────────────────────────────────────────
# Graceful-shutdown grace period in milliseconds. After SIGTERM the
# server stops accepting new connections, waits for in-flight requests
# to drain, then exits. If draining takes longer than this, the
# process force-exits.
SHUTDOWN_GRACE_MS=15000
