{
  "name": "ag-ui-maverick",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Angular library + schematics for agentic UIs (AG-UI / Hashbrown / A2UI) with first-class microfrontend support",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "lint:studio": "eslint platform/agentic-experience-studio/src",
    "build:lib": "ng build agentic-ui && npm run build:schematics",
    "watch:lib": "ng build agentic-ui --watch",
    "build:schematics": "tsc -p projects/agentic-ui/schematics/tsconfig.json && node scripts/copy-schematics-assets.mjs",
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch",
    "docs:compodoc:prepare": "node scripts/prepare-compodoc-includes.mjs",
    "docs:compodoc": "npm run docs:compodoc:prepare && compodoc -c .compodocrc.json",
    "docs:compodoc:serve": "npm run docs:compodoc:prepare && compodoc -c .compodocrc.json -s",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:studio": "playwright test --config e2e/studio.config.ts",
    "test:e2e:install": "playwright install chromium",
    "build:ediscovery-shared": "npm --prefix examples/demo-ediscovery-shared run build",
    "build:ediscovery-server": "npm --prefix examples/demo-ediscovery-server run build"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.52",
    "@angular-architects/module-federation": "^21.2.2",
    "@angular-architects/native-federation": "^21.2.3",
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@softarc/native-federation-node": "^3.3.4",
    "cytoscape": "^3.33.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "es-module-shims": "^1.5.12",
    "material-icons": "^1.13.14",
    "rxjs": "7.8.1",
    "tslib": "^2.3.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/schematics": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@compodoc/compodoc": "^1.2.1",
    "@hashbrownai/core": "^0.4.1",
    "@playwright/test": "^1.59.1",
    "@schematics/angular": "^21.0.0",
    "@types/node": "^22.10.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.0.0",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.8"
  }
}
