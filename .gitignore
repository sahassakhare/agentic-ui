# Compiled output (rooted + nested)
/dist
dist/
/tmp
tmp/
/out-tsc
/bazel-out

# Node (rooted + nested)
/node_modules
node_modules/
npm-debug.log
yarn-error.log
.npm/
*.tsbuildinfo

# IDE
/.idea
/.project
/.classpath
/.c9/
*.launch
.settings/
*.sublime-workspace
/.vscode/*
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/tasks.json
/.history/*

# Angular cache
/.angular/cache

# Misc
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.env.*.local

# Tool-output (not committed; Claude session state lives elsewhere)
.claude/
/.claude/local
PLAN.md

# Generated API docs (built by `npm run docs:api`; published, not tracked)
/docs/api/

# Compodoc output + the build-time-synced includes folder.
# `docs/compodoc-includes/summary.json` IS tracked; the .md files copied
# next to it at build time are not.
/docs/compodoc/
/docs/compodoc-includes/*.md

# Playwright artefacts — JUnit XML lands in e2e/results/ for CI consumers.
/test-results/
/playwright-report/
/e2e/results/
