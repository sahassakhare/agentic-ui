# Copy to `.env` and fill in your values. `.env` is git-ignored.

# ─── Required for LLM-backed specialists ──────────────────────────────
# Get an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model override.
# GEMINI_MODEL=gemini-2.5-flash

# ─── Server ───────────────────────────────────────────────────────────
# PORT=4311
# LOG_LEVEL=info

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins, '*' = permissive (DEV ONLY).
CORS_ORIGINS=*

# ─── Auth ─────────────────────────────────────────────────────────────
# Comma-separated bearer tokens. Empty = auth disabled (DEV ONLY).
# Real eDiscovery deployments would use SSO / SAML — this is a demo.
AGENT_AUTH_TOKENS=
