# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# ─── Required for the Gemini agent ─────────────────────────────────────────
# Get an API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini model override. Set this to switch the agent + classifier
# model. The codebase defaults to `gemini-2.5-flash`; common alternatives:
#   gemini-2.5-flash         — stable, 20 free-tier requests/day
#   gemini-2.5-flash-lite    — stable, 1000 free-tier requests/day, lower quality
#   gemini-3-flash-preview   — Gemini 3 flash preview (preview-tier quota)
#   gemini-3.1-flash-lite-preview — Gemini 3.1 flash lite preview
# Run `curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY" | jq '.models[].name'`
# against your key to see the full list of model ids you can use.
# GEMINI_MODEL=gemini-3-flash-preview

# ─── Server ────────────────────────────────────────────────────────────────
# Port the server listens on (default 4111).
# PORT=4111

# Log level: debug | info | warn | error (default info).
# LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. '*' = permissive (DEV ONLY).
# In production set explicit origins, e.g.:
#   CORS_ORIGINS=https://app.example.com,https://staging.app.example.com
CORS_ORIGINS=*

# ─── Authentication ────────────────────────────────────────────────────────
# Comma-separated list of bearer tokens that are accepted in the
# `Authorization: Bearer <token>` header. Empty = auth disabled (DEV ONLY).
# Example:
#   AGENT_AUTH_TOKENS=local-dev-12345,canary-67890
AGENT_AUTH_TOKENS=
